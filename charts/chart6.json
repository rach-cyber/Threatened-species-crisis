{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "config": {
    "background": "#1a1e35",
    "font": "DM Sans",
    "view": {"stroke": null},
    "legend": {
      "labelColor": "#9a96a0",
      "titleColor": "#9a96a0",
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "title": null
    }
  },
  "data": {"url": "data/epbc_treemap.csv"},
  "transform": [
    {"calculate": "(datum.x + datum.x2) / 2", "as": "cx"},
    {"calculate": "(datum.y + datum.y2) / 2", "as": "cy"},
    {"calculate": "datum.y2 - datum.y", "as": "h"},
    {"calculate": "format(datum.percentage, '.0f') + '%'", "as": "pctlabel"}
  ],
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#1a1e35", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "axis": null, "scale": {"domain": [0, 600]}},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [0, 350]}},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"},
        "color": {
          "field": "taxa",
          "type": "nominal",
          "scale": {
            "domain": ["Plants", "Birds", "Mammals", "Invertebrates", "Reptiles", "Fish", "Frogs"],
            "range": ["#2a9d8f", "#e9c46a", "#f4a261", "#e63946", "#457b9d", "#264653", "#a8dadc"]
          },
          "legend": {"orient": "bottom", "columns": 4, "labelFontSize": 10, "symbolSize": 80}
        },
        "tooltip": [
          {"field": "taxa", "type": "nominal", "title": "Group"},
          {"field": "count", "type": "quantitative", "title": "Species"},
          {"field": "percentage", "type": "quantitative", "title": "Share (%)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.taxa == 'Plants'"}],
      "mark": {"type": "text", "align": "center", "baseline": "middle", "fontWeight": "bold", "color": "#0d0f1a", "fontSize": 15},
      "encoding": {
        "x": {"field": "cx", "type": "quantitative"},
        "y": {"field": "cy", "type": "quantitative"},
        "text": {"value": "Plants"}
      }
    },
    {
      "transform": [{"filter": "datum.taxa == 'Plants'"}],
      "mark": {"type": "text", "align": "center", "baseline": "middle", "color": "#0d0f1a", "fontSize": 11, "dy": 18},
      "encoding": {
        "x": {"field": "cx", "type": "quantitative"},
        "y": {"field": "cy", "type": "quantitative"},
        "text": {"field": "pctlabel", "type": "nominal"}
      }
    },
    {
      "transform": [{"filter": "datum.taxa != 'Plants' && datum.h > 30"}],
      "mark": {"type": "text", "align": "center", "baseline": "middle", "color": "#0d0f1a", "fontSize": 9},
      "encoding": {
        "x": {"field": "cx", "type": "quantitative"},
        "y": {"field": "cy", "type": "quantitative"},
        "text": {"field": "taxa", "type": "nominal"}
      }
    }
  ]
}
