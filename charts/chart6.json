{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {"step": 34},
  "config": {
    "background": "#1a1e35",
    "font": "DM Sans",
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#d8d4cc",
      "titleColor": "#9a96a0",
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 11,
      "domainColor": "rgba(255,255,255,0.1)",
      "tickColor": "rgba(255,255,255,0.1)",
      "gridColor": "rgba(255,255,255,0.04)"
    }
  },
  "data": {"url": "data/epbc_by_taxa.csv"},
  "transform": [
    {"calculate": "format(datum.count, ',') + '  ·  ' + format(datum.percentage, '.0f') + '%'", "as": "label"}
  ],
  "encoding": {
    "y": {
      "field": "taxa",
      "type": "nominal",
      "title": null,
      "sort": {"field": "count", "order": "descending"}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 3},
      "encoding": {
        "x": {
          "field": "count",
          "type": "quantitative",
          "title": "Number of threatened species",
          "scale": {"domain": [0, 1700]}
        },
        "color": {
          "field": "taxa",
          "type": "nominal",
          "scale": {
            "domain": ["Plants", "Birds", "Mammals", "Invertebrates", "Reptiles", "Fish", "Frogs"],
            "range": ["#2a9d8f", "#e9c46a", "#f4a261", "#e63946", "#457b9d", "#264653", "#a8dadc"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "taxa", "type": "nominal", "title": "Group"},
          {"field": "count", "type": "quantitative", "title": "Species"},
          {"field": "percentage", "type": "quantitative", "title": "Share (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 6, "fontSize": 11, "color": "#d8d4cc"},
      "encoding": {
        "x": {"field": "count", "type": "quantitative", "scale": {"domain": [0, 1700]}},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ]
}
