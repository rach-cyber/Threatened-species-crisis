{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 300,
  "config": {
    "background": "#1a1e35",
    "font": "DM Sans",
    "view": {"stroke": null},
    "legend": {
      "labelColor": "#9a96a0",
      "titleColor": "#9a96a0",
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "title": null
    }
  },
  "data": {"sequence": {"start": 0, "stop": 100, "as": "i"}},
  "transform": [
    {"calculate": "9 - floor(datum.i / 10)", "as": "row"},
    {"calculate": "datum.i % 10", "as": "col"},
    {"calculate": "datum.i < 10 ? 'Extinct since 1788' : 'Surviving'", "as": "status"}
  ],
  "mark": {"type": "square", "size": 460, "cornerRadius": 2},
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": ["Extinct since 1788", "Surviving"],
        "range": ["#e63946", "#2a2f4d"]
      },
      "legend": {"orient": "bottom", "symbolType": "square", "symbolSize": 120}
    },
    "tooltip": [{"field": "status", "type": "nominal", "title": "Status"}]
  }
}
