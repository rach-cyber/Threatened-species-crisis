{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 350,
  "config": {
    "background": "#1a1e35",
    "font": "DM Sans",
    "view": {"stroke": null}
  },
  "data": {"url": "data/epbc_treemap.csv"},
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#1a1e35",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "axis": null, "scale": {"domain": [0, 600]}},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [0, 350]}},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"},
        "color": {
          "field": "taxa",
          "type": "nominal",
          "scale": {
            "domain": ["Plants", "Birds", "Mammals", "Invertebrates", "Reptiles", "Fish", "Frogs"],
            "range": ["#2a9d8f", "#e9c46a", "#f4a261", "#e63946", "#457b9d", "#264653", "#a8dadc"]
          },
          "legend": {
            "orient": "bottom",
            "columns": 4,
            "labelColor": "#9a96a0",
            "titleColor": "#9a96a0",
            "labelFont": "DM Sans",
            "titleFont": "DM Sans",
            "labelFontSize": 10,
            "title": null
          }
        },
        "tooltip": [
          {"field": "taxa", "type": "nominal", "title": "Group"},
          {"field": "count", "type": "quantitative", "title": "Species"},
          {"field": "percentage", "type": "quantitative", "title": "Share (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "font": "DM Sans",
        "fontWeight": "500"
      },
      "encoding": {
        "x": {
          "expr": "(datum.x + datum.x2) / 2",
          "type": "quantitative",
          "axis": null,
          "scale": {"domain": [0, 600]}
        },
        "y": {
          "expr": "(datum.y + datum.y2) / 2",
          "type": "quantitative",
          "axis": null,
          "scale": {"domain": [0, 350]}
        },
        "text": {"field": "taxa", "type": "nominal"},
        "color": {"value": "#1a1e35"},
        "size": {
          "expr": "datum.taxa === 'Plants' ? 18 : datum.taxa === 'Birds' || datum.taxa === 'Mammals' ? 13 : 10"
        }
      }
    }
  ]
}
