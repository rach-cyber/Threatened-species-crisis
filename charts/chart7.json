{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {"step": 22},
  "config": {
    "background": "#1a1e35",
    "font": "DM Sans",
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#9a96a0",
      "titleColor": "#9a96a0",
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 11,
      "domainColor": "rgba(255,255,255,0.1)",
      "tickColor": "rgba(255,255,255,0.1)",
      "gridColor": "rgba(255,255,255,0.05)"
    },
    "legend": {
      "labelColor": "#9a96a0",
      "titleColor": "#9a96a0",
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 10
    }
  },
  "data": {"url": "data/tsx_top15_decline.csv"},
  "transform": [{"calculate": "format(datum.pct_change, '.1f') + '%'", "as": "label"}],
  "encoding": {
    "y": {
      "field": "name",
      "type": "nominal",
      "title": null,
      "sort": {"field": "pct_change", "order": "ascending"},
      "axis": {"labelLimit": 220, "labelFontSize": 10}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 3},
      "encoding": {
        "x": {
          "field": "pct_change",
          "type": "quantitative",
          "title": "Population change since monitoring began (%)",
          "scale": {"domain": [-112, 0]}
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "title": "Threat status",
          "scale": {
            "domain": ["Critically Endangered", "Endangered", "Vulnerable"],
            "range": ["#e63946", "#f4a261", "#e9c46a"]
          },
          "legend": {"orient": "bottom", "direction": "horizontal"}
        },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "Species"},
          {"field": "taxa", "type": "nominal", "title": "Group"},
          {"field": "status", "type": "nominal", "title": "Status"},
          {"field": "pct_change", "type": "quantitative", "title": "Population change (%)", "format": ".1f"},
          {"field": "period", "type": "nominal", "title": "Period"},
          {"field": "n_sites", "type": "quantitative", "title": "Monitoring sites"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "right", "baseline": "middle", "dx": -5, "fontSize": 10, "color": "#f0ece4"},
      "encoding": {
        "x": {"field": "pct_change", "type": "quantitative", "scale": {"domain": [-112, 0]}},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ]
}
